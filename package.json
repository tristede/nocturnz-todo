{
  "name": "nocturnz-todo",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:emu": "VITE_EMULATORS=1 vite",
    "build": "vite build",
    "preview": "vite preview --port 3200",
    "emulators": "firebase emulators:start --project demo-nocturnz-todo --only auth,firestore",
    "test:rules": "firebase emulators:exec --project demo-nocturnz-todo --only firestore \"node tests/rules.test.mjs\"",
    "deploy": "vite build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^12.0.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.0",
    "vite": "^7.0.0"
  }
}
